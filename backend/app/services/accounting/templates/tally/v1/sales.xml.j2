<VOUCHER VCHTYPE="{{ voucher_type }}" ACTION="Create">
  <DATE>{{ invoice.invoice_date.strftime('%Y%m%d') }}</DATE>
  <VOUCHERTYPENAME>{{ voucher_type }}</VOUCHERTYPENAME>
  <VOUCHERNUMBER>{{ invoice.invoice_number }}</VOUCHERNUMBER>
  <PERSISTEDVIEW>Invoice Voucher View</PERSISTEDVIEW>
  <ISINVOICE>Yes</ISINVOICE>
  <NARRATION>Generated by ERP</NARRATION>

  <LEDGERENTRIES.LIST>
    <LEDGERNAME>{{ customer_ledger_name }}</LEDGERNAME>
    <ISDEEMEDPOSITIVE>Yes</ISDEEMEDPOSITIVE>
    <ISPARTYLEDGER>Yes</ISPARTYLEDGER>
    <AMOUNT>-{{ "%.2f"|format(invoice.grand_total) }}</AMOUNT>
    <BILLALLOCATIONS.LIST>
      <NAME>{{ invoice.invoice_number }}</NAME>
      <BILLTYPE>New Ref</BILLTYPE>
      <AMOUNT>-{{ "%.2f"|format(invoice.grand_total) }}</AMOUNT>
    </BILLALLOCATIONS.LIST>
  </LEDGERENTRIES.LIST>

  {% for line in invoice.lines %}
  <ALLINVENTORYENTRIES.LIST>
    <STOCKITEMNAME>{{ resolve_product(line.product_sku) }}</STOCKITEMNAME>
    <ISDEEMEDPOSITIVE>No</ISDEEMEDPOSITIVE>
    <RATE>{{ "%.2f"|format(line.rate) }}/{{ line.unit or 'nos' }}</RATE>
    <AMOUNT>{{ "%.2f"|format(line.taxable_amount) }}</AMOUNT>
    <ACTUALQTY>{{ line.quantity }} {{ line.unit or 'nos' }}</ACTUALQTY>
    <BILLEDQTY>{{ line.quantity }} {{ line.unit or 'nos' }}</BILLEDQTY>
    <BATCHALLOCATIONS.LIST>
      <GODOWNNAME>{{ default_godown }}</GODOWNNAME>
      <BATCHNAME>Primary Batch</BATCHNAME>
      <AMOUNT>{{ "%.2f"|format(line.taxable_amount) }}</AMOUNT>
      <ACTUALQTY>{{ line.quantity }} {{ line.unit or 'nos' }}</ACTUALQTY>
      <BILLEDQTY>{{ line.quantity }} {{ line.unit or 'nos' }}</BILLEDQTY>
    </BATCHALLOCATIONS.LIST>
    <ACCOUNTINGALLOCATIONS.LIST>
      <LEDGERNAME>{{ default_sales_ledger }}</LEDGERNAME>
      <ISDEEMEDPOSITIVE>No</ISDEEMEDPOSITIVE>
      <AMOUNT>{{ "%.2f"|format(line.taxable_amount) }}</AMOUNT>
    </ACCOUNTINGALLOCATIONS.LIST>
  </ALLINVENTORYENTRIES.LIST>
  {% endfor %}

  {% if total_cgst > 0 %}
  <LEDGERENTRIES.LIST>
    <LEDGERNAME>{{ resolve_ledger('CGST') }}</LEDGERNAME>
    <ISDEEMEDPOSITIVE>No</ISDEEMEDPOSITIVE>
    <AMOUNT>{{ "%.2f"|format(total_cgst) }}</AMOUNT>
  </LEDGERENTRIES.LIST>
  {% endif %}
  
  {% if total_sgst > 0 %}
  <LEDGERENTRIES.LIST>
    <LEDGERNAME>{{ resolve_ledger('SGST') }}</LEDGERNAME>
    <ISDEEMEDPOSITIVE>No</ISDEEMEDPOSITIVE>
    <AMOUNT>{{ "%.2f"|format(total_sgst) }}</AMOUNT>
  </LEDGERENTRIES.LIST>
  {% endif %}

  {% if total_igst > 0 %}
  <LEDGERENTRIES.LIST>
    <LEDGERNAME>{{ resolve_ledger('IGST') }}</LEDGERNAME>
    <ISDEEMEDPOSITIVE>No</ISDEEMEDPOSITIVE>
    <AMOUNT>{{ "%.2f"|format(total_igst) }}</AMOUNT>
  </LEDGERENTRIES.LIST>
  {% endif %}
  
  {% if round_off != 0 %}
  <LEDGERENTRIES.LIST>
    <LEDGERNAME>{{ default_round_off_ledger }}</LEDGERNAME>
    <ISDEEMEDPOSITIVE>{% if round_off > 0 %}No{% else %}Yes{% endif %}</ISDEEMEDPOSITIVE>
    <AMOUNT>{{ "%.2f"|format(round_off) }}</AMOUNT>
  </LEDGERENTRIES.LIST>
  {% endif %}
</VOUCHER>
